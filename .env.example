# порт приложения
APP_PORT=3000

# имя базы данных MySQL
MYSQL_DATABASE=priemka
# пользователь MySQL
MYSQL_USER=priemka_app
# пароль пользователя MySQL
MYSQL_PASSWORD=replace_with_local_app_password
# служебный пароль root MySQL
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

# токен бота MAX
MAX_BOT_TOKEN=replace_with_your_max_bot_token
# максимальный возраст initData в секундах
MAX_INIT_DATA_MAX_AGE_SECONDS=3600
# уровень серверных логов
LOG_LEVEL=info
