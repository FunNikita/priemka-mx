# Для prod: COMPOSE_PROJECT_NAME=priemka-prod, APP_PORT=3000
# Для dev: COMPOSE_PROJECT_NAME=priemka-dev, APP_PORT=3001
# Эти порты — примеры; для каждого окружения задайте свой свободный APP_PORT.
COMPOSE_PROJECT_NAME=priemka-mx
# порт приложения
APP_PORT=3000
PUBLIC_BASE_URL=https://example.com
# Только для demo включайте явно: ALLOW_SELF_ROLE_SWITCH=true
ALLOW_SELF_ROLE_SWITCH=false

# имя базы данных MySQL
MYSQL_DATABASE=priemka
# пользователь MySQL
MYSQL_USER=priemka_app
# пароль пользователя MySQL
MYSQL_PASSWORD=replace_with_local_app_password
# служебный пароль root MySQL
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

# токен бота MAX
MAX_BOT_TOKEN=replace_with_your_max_bot_token
# публичный ник бота без @, используется в QR
MAX_BOT_NAME=replace_with_bot_name
# секрет подписки webhook (X-Max-Bot-Api-Secret)
MAX_WEBHOOK_SECRET=replace_with_random_webhook_secret
# максимальный возраст initData в секундах
MAX_INIT_DATA_MAX_AGE_SECONDS=3600
# false отключает регистрацию webhook и отправку BotOutbox (например, на EVAL)
MAX_OUTBOUND_ENABLED=true
# уровень серверных логов
LOG_LEVEL=info
# Закрытый тест включается явно. Администратор тоже должен быть в PreviewAccess.
PREVIEW_ACCESS_REQUIRED=false
BOT_TIME_ZONE=Europe/Moscow
# Доверять X-Forwarded-For только от точного IP reverse proxy; пусто = socket IP.
TRUSTED_PROXY_IP=
# Дополнительный JSONL журнал в контейнере; хранится в отдельном volume.
APP_LOG_DIR=/app/data/logs
LOG_RETENTION_DAYS=14
