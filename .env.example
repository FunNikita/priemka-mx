# Порт приложения на 127.0.0.1 для FastPanel; не секрет.
APP_PORT=3000

# Имя базы данных MySQL; не секрет.
MYSQL_DATABASE=priemka
# Пользователь MySQL для приложения (не root); не секрет.
MYSQL_USER=priemka_app
# Пароль пользователя приложения MySQL; секрет, замените в локальном .env.
MYSQL_PASSWORD=replace_with_local_app_password
# Служебный пароль root MySQL; секрет, backend его не использует.
MYSQL_ROOT_PASSWORD=replace_with_local_root_password

# Токен MAX-бота для проверки подписи initData на backend; секрет, замените в локальном .env.
MAX_BOT_TOKEN=replace_with_your_max_bot_token
# Максимальный возраст initData в секундах; не секрет.
MAX_INIT_DATA_MAX_AGE_SECONDS=3600
# Уровень серверных логов; не секрет.
LOG_LEVEL=info
